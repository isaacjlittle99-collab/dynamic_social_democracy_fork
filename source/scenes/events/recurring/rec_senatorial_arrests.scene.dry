on-arrival: {!
Q.arrests_done = 1;
if (Q.arrests_hedged) {
  Q.adv_antilles = 0; Q.adv_organa = 0; Q.adv_mothma = 0; Q.adv_amidala = 0; Q.adv_chuchi = 0; Q.adv_bel_iblis = 0; Q.adv_farr = 0; Q.adv_valorum = 0;
  SW.countAdvisors(Q);
  for (var i = 0; i < SW.REGIONS.length; i++) Q[SW.REGIONS[i] + '_rc'] *= 0.5;
  Q.capital = Math.min(Q.capital, 0); Q.senate_resolve += 1; Q.faith -= 4;
  Q.arrests_survived = 1;
} else {
  Q.empire_declared = 1; Q.game_ending = 1; Q.seeds = 1; Q.arrests_broke = 1;
}
