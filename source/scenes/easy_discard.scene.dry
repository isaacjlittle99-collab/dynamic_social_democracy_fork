title: Put this card back in your hand.
subtitle: Undo is available on Story and Senator difficulty.
view-if: difficulty <= 0
go-to: root
on-arrival: {!
if (Q.turn_actions > 0) Q.turn_actions -= 1;
var card = this.state.lastPlayedCard;
var handId = Q.difficulty < 0 ? 'main_story' : 'main';
if (card && this.state.currentHands && this.state.currentHands[handId]) {
    this.state.currentHands[handId].push({id: card.id, title: card.title, image: card.cardImage});
    if (this.state.visits[card.id]) this.state.visits[card.id] -= 1;
}
if (Q.last_card_timer) {
    Q[Q.last_card_timer + '_timer'] = 0;
    Q.last_card_timer = '';
}
!}
