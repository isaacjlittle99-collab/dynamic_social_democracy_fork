title: Post Event
new-page: true
on-arrival: {!
if (!Q.started) return;
SW.migrate(Q);
// 1. advance the turn once the player has acted
if (Q.turn_actions >= 1 && !Q.game_ending) {
    Q.turn_actions = 0;
    SW.advanceTurn(Q, this);
    Q.turn_advanced = 1;
} else {
    Q.turn_advanced = 0;
}
if (Q.clear_hand && this.state.currentHands) {
    this.state.currentHands.main = [];
    this.state.currentHands.main_story = [];
    Q.clear_hand = 0;
}
// 2. recompute everything that is derived from state
SW.everyVisit(Q);
SW.countAdvisors(Q);
// 3. end guards
if (!Q.game_ending) {
    if (Q.date >= 180 && !Q.finale) Q.force_end = 1;
    if (Q.finale && Q.finale_day > 12) Q.force_end = 1;
}
// 4. are there events waiting?
Q.has_event = 0;
var choices = this._compileChoices(this.game.scenes['post_event.events_choice']);
if (choices && choices.length && choices[0].title !== 'Continue...') {
    Q.has_event = 1;
}
// 5. ui strings
var t = Q.advisor_action_timer;
var unit = Q.finale ? 'day' : 'turn';
Q.pinnedCardsDescription = 'Advisors (one action shared between them): ' +
    (t <= 0 ? 'an action is available.' : 'next action in ' + t + ' ' + unit + (t === 1 ? '' : 's') + '.') +
    (Q.shuffle_timer <= 0 ? ' The Caucus leadership can be reshuffled.' : '');
Q.handDescription = 'Your hand - play one card to end the turn.';
Q.deckDescription = 'Decks - click a deck to draw a card (hand holds ' + (Q.difficulty < 0 ? 'four' : 'three') + ').';
!}
go-to: ending_router if force_end = 1 or game_ending = 1; events_choice if has_event = 1 and not force_end and not game_ending; main if has_event = 0 and not force_end and not game_ending and difficulty >= 0; main_story if has_event = 0 and not force_end and not game_ending and difficulty < 0

= [+ date_label +]

@events_choice

- #event

# This scene advances time once a card has been played, then routes to waiting events or to the main hand.

@ending_router
on-arrival: {! Q.ending = SW.routeEnding(Q); Q.ending_title = SW.ENDING_TITLES[Q.ending]; !}
go-to: ending_slides
